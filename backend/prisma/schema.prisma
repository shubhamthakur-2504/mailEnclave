generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  vaultPinHash String?      // Hashed PIN for the vault
  configs      UserConfig[]
  emails       Email[]
  privateTags  PrivateTag[] // Relation to locked tags
  refreshTokens RefreshToken[] // Relation to refresh tokens
  createdAt    DateTime     @default(now())
}

model UserConfig {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  namespace       String
  encryptedApiKey String
  emails          Email[]
  privateTags     PrivateTag[] // Relation to locked tags
  lastSyncedAt    DateTime?
  lastAccessedAt  DateTime?
  createdAt       DateTime @default(now())

  @@unique([userId, namespace])
  @@index([lastAccessedAt])
  @@index([lastSyncedAt])
}

model Email {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  configId   String
  config     UserConfig @relation(fields: [configId], references: [id])
  testmailId String
  tag        String
  subject    String
  from       String?
  htmlBody   String?
  textBody   String?
  isRead     Boolean  @default(false)
  isPrivate  Boolean  @default(false)
  receivedAt DateTime

  @@unique([userId, testmailId])
  @@index([configId, receivedAt])
  @@index([tag])
  @@index([isPrivate])
}

model PrivateTag {
  id        String     @id @default(uuid())
  tag       String     // The specific tag string (e.g., "nighthawk")
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  configId  String
  config    UserConfig @relation(fields: [configId], references: [id])

  @@unique([configId, tag]) // A specific tag in a specific namespace can only be locked once
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String
  issuedAt   DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  replacedBy String?
  createdByIp String?
  userAgent   String?

  @@index([userId])
  @@index([expiresAt])
}
